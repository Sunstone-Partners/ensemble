{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ensemble Behavior v1",
  "description": "Schema for behavior.yaml packages (api_version ensemble.sunstone.dev/v1). additionalProperties: false at every object level (REQ-001 AC-004).",
  "type": "object",
  "required": ["api_version", "kind", "metadata", "trigger", "outcomes"],
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "ensemble.sunstone.dev/v1"
    },
    "kind": {
      "const": "Behavior"
    },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "description"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,64}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "trigger": {
      "type": "object",
      "required": ["event_type"],
      "additionalProperties": false,
      "properties": {
        "event_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$"
        },
        "predicate": {
          "$ref": "#/definitions/predicate"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["observe", "propose", "active"]
        },
        "max_concurrent": {
          "type": "integer",
          "minimum": 1
        },
        "cooldown": {
          "$ref": "#/definitions/duration"
        },
        "timeout": {
          "$ref": "#/definitions/duration"
        },
        "max_causal_depth": {
          "type": "integer",
          "minimum": 0
        },
        "max_children": {
          "type": "integer",
          "minimum": 0
        },
        "dedup_window": {
          "$ref": "#/definitions/duration"
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "retryable": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)*$" },
          "uniqueItems": true
        },
        "mutation_classes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "execution": {
      "type": "object",
      "required": ["graph"],
      "additionalProperties": false,
      "properties": {
        "graph": { "type": "string", "minLength": 1 },
        "params": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "object" },
              { "type": "array" }
            ]
          }
        }
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$"
      },
      "uniqueItems": true
    },
    "constitution_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "approval_required": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "approvers": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          }
        }
      }
    }
  },
  "definitions": {
    "duration": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+(s|m|h|d)$"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "predicate": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/constraint"
      }
    },
    "constraint": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 6,
      "additionalProperties": false,
      "properties": {
        "equals": {},
        "not": {},
        "matches": { "type": "string" },
        "gte": { "type": "number" },
        "lte": { "type": "number" },
        "contains": {}
      }
    }
  }
}
