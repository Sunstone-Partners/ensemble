# This file exists so npm does NOT fall back to the repo's .gitignore when
# packing this package.
#
# The "files" array in package.json is the real allowlist for the tarball.
# Without an .npmignore present, npm falls back to the root .gitignore, which
# excludes build output such as dist/ -- so packing would silently drop the
# compiled generator. Keeping this (intentionally minimal) file pins tarball
# contents to the package.json "files" allowlist instead.
